{
	"name": "scroll-active-toc",
	"type": "module",
	"version": "0.0.0",
	"private": false,
	"description": "Framework-agnostic scroll-spy / active TOC link engine. Pure TypeScript, zero dependencies.",
	"author": {
		"name": "Condor Hero",
		"email": "love2xinwei@gmail.com"
	},
	"license": "MIT",
	"homepage": "https://condorheroblog.github.io/scroll-active-toc/",
	"repository": {
		"type": "git",
		"url": "https://github.com/condorheroblog/scroll-active-toc.git",
		"directory": "scroll-active-toc"
	},
	"bugs": {
		"url": "https://github.com/condorheroblog/scroll-active-toc/issues"
	},
	"keywords": [
		"scrollspy",
		"scroll-spy",
		"scroll-active",
		"active-link",
		"active-toc",
		"toc",
		"table-of-contents",
		"framework-agnostic",
		"vanilla-js",
		"react",
		"vue",
		"solid"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"files": [
		"dist/*"
	],
	"scripts": {
		"postinstall": "simple-git-hooks",
		"prepublishOnly": "npm run build",
		"build": "rm -rf dist && tsc --noEmit && vite build",
		"test": "vitest",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"release": "bumpp -r && pnpm -r publish --access public"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.5.1",
		"@microsoft/api-extractor": "^7.59.0",
		"@types/node": "^26.4.1",
		"bumpp": "^12.3.0",
		"happy-dom": "^20.14.3",
		"simple-git-hooks": "^2.14.0",
		"typescript": "^6.0.3",
		"unplugin-dts": "^1.1.0",
		"vite": "8.2.2",
		"vitest": "^4.1.11"
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged"
	},
	"lint-staged": {
		"*.{ts,js,mjs,cjs,cts,mts,json,md}": [
			"eslint --fix"
		]
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	}
}
